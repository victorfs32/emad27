# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (ou "anon" nos projetos antigos). NUNCA use a service_role aqui.
# (ou NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave de administração (somente servidor): permite cadastrar usuários pela página Equipe. NUNCA use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
